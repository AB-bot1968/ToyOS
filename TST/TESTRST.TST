# FIX51 Managed Process Recovery Lifecycle exhaustive automated acceptance.
PRINT FIX51 MANAGED PROCESS RECOVERY TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
RUN eventlog clear
RUN rm RCONCE.DAT
ASSERT SAFE_MODE 0
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
# Success path: first RCONCE instance creates marker, leaks a handle and faults;
# restarted same EXE observes marker, heartbeats, deletes marker and exits cleanly.
RUN supstart RCONCE.EXE
WAIT LAST
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 0
ASSERT RM_LIMIT 3
ASSERT RM_ATTEMPTS 1
ASSERT RM_KIND 1
ASSERT RM_ACTION 1
ASSERT RM_STATE 4
ASSERT RM_RESULT 1
ASSERT RM_PID_CHANGED
ASSERT SAFE_MODE 1
ASSERT PROC_HANDLES 0
# Failure path: restarted HANGWD never produces a heartbeat. Three bounded
# restart authorizations are followed by budget exhaustion and SAFE.
RUN safemode normal 0
RUN supstart HANGWD.EXE
WAIT LAST
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 3
ASSERT RM_LIMIT 3
ASSERT RM_ATTEMPTS 3
ASSERT RM_KIND 2
ASSERT RM_ACTION 2
ASSERT RM_STATE 6
ASSERT SAFE_MODE 2
ASSERT SAFE_REASON 4592
ASSERT EVENT_TYPE 104
ASSERT EVENT_TYPE 103
ASSERT EVENT_TYPE 105
ASSERT EVENT_TYPE 102
ASSERT EVENT_SEQ_MONOTONIC
ASSERT EVENT_TICK_MONOTONIC
RUN mtstop ALL
RUN hwwd disarm
RUN safemode normal 0
RUN rtstat stop
RUN rtstat reset
RUN rm RCONCE.DAT
ASSERT SAFE_MODE 0
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX51 MANAGED PROCESS RECOVERY TEST COMPLETE
