# FIX60P: 1000 successful production SONAR cycles using bounded RX injection.
PRINT FIX60P SONAR 1000-CYCLE ENDURANCE
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
RUN execmt SONARTST.EXE
ASSERT MT_ACTIVE 1
ASSERT DATA_PUBLISHED_WAIT 0 1000 1000
ASSERT MT_HEARTBEAT_WAIT 1 1000 100
ASSERT MT_PROGRESS 1 3
RUN mtstop ALL
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX60P SONAR 1000-CYCLE ENDURANCE PASS
