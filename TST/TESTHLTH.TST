# FIX47 consolidated system health monitor regression.
PRINT FIX47 SYSTEM HEALTH MONITOR TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT HEALTH_STATE 0
ASSERT HEALTH_FLAGS 0
ASSERT HEALTH_RT 0
ASSERT HEALTH_MT 0
ASSERT HEALTH_HANDLES 0
RUN health
RUN safemode degraded 4701
ASSERT HEALTH_STATE 1
ASSERT HEALTH_FLAGS 1
RUN health
RUN safemode safe 4702
ASSERT HEALTH_STATE 2
ASSERT HEALTH_FLAGS 2
RUN health
RUN safemode normal 0
ASSERT HEALTH_STATE 0
ASSERT HEALTH_FLAGS 0
RUN hwwd disarm
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT HEALTH_STATE 0
PRINT SYSTEM HEALTH MONITOR TEST COMPLETE
