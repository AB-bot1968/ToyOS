# FIX60Q: deterministic lifecycle test for the physical RX probe source.
PRINT FIX60Q UART RX PROBE OFFLINE SCHEDULER TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
RUN uartreset
RUN execmt UARTRXT.EXE
ASSERT MT_ACTIVE 1
ASSERT MT_PROGRESS 1 3
ASSERT MT_HEARTBEAT 1 10
ASSERT UART_ENABLED 0
ASSERT UART_IRQ4 0
RUN mtstop ALL
RUN uartreset
ASSERT MT_ACTIVE 0
ASSERT UART_ENABLED 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX60Q UART RX PROBE OFFLINE SCHEDULER PASS
