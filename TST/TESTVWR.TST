# FIX60ZEG: explicit MT viewer + automatic shell prompt redraw under 4RT.
# The test uses the real 2MT + 4RT 10-ms class and waits for each transient
# viewer PID, proving that PROCESS_WAIT cannot starve MT under continuous RT.
PRINT FIX60ZEG LIVE SONAR VIEWER EXECMT PROMPT REDRAW TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN rm /SONAR.LOG
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT DATA_PUBLISHED_WAIT 0 8 300
ASSERT MT_HEARTBEAT_WAIT 2 5 300
START RT10 4
ASSERT RT_ACTIVE 4
ASSERT RT_SWEEP_FAIR 4 4
RUN execmt SONARVWR.EXE
WAIT LAST
# Viewer wrote asynchronously and exited: the next shell read must request an
# automatic prompt redraw instead of requiring a manual ENTER.
ASSERT CONSOLE_REDRAW
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 0
ASSERT MT_HEARTBEAT_WAIT 2 8 400
ASSERT RT_SWEEP_FAIR 4 4
RUN execmt SONARVWR.EXE
WAIT LAST
ASSERT CONSOLE_REDRAW
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 0
ASSERT MT_HEARTBEAT_WAIT 2 11 400
RUN execmt SONARVWR.EXE
WAIT LAST
ASSERT CONSOLE_REDRAW
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 0
ASSERT MT_HEARTBEAT_WAIT 2 14 400
RUN execmt SONARVWR.EXE
WAIT LAST
ASSERT CONSOLE_REDRAW
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 0
ASSERT MT_HEARTBEAT_WAIT 2 17 400
ASSERT MT_ACTIVE 2
ASSERT RT_ACTIVE 4
ASSERT MT_PROGRESS 1 3
ASSERT MT_PROGRESS 2 3
ASSERT RT_SWEEP_FAIR 4 4
RUN ps
RUN mtstat
RUN rtstat
ASSERT CONSOLE_IDLE_TICKS 8
RUN rtstat stop
RUN mtstop ALL
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT FILE_SIZE /SONAR.LOG 4160
PRINT FIX60ZEG LIVE SONAR VIEWER EXECMT PROMPT REDRAW PASS
