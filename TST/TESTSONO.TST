# FIX60O: exercise the successful SONAR response -> publish -> heartbeat path repeatedly.
PRINT FIX60O SONAR SUCCESS PATH TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
RUN execmt SONARTST.EXE
ASSERT MT_ACTIVE 1
ASSERT MT_PROGRESS 1 3
ASSERT DATA_PUBLISHED 0 2
ASSERT MT_HEARTBEAT 1 2
RUN mtstop ALL
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX60O SONAR SUCCESS PATH PASS
