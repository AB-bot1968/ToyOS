# FIX60N: real SONARDRV must receive CPU and foreground test runner must regain CPU without a serial peer.
PRINT FIX60N SONARDRV SCHEDULER PROGRESS TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
ASSERT FILE_EXISTS /SONARDRV.EXE
RUN execmt SONARDRV.EXE
ASSERT MT_ACTIVE 1
ASSERT MT_PROGRESS 1 2
RUN ps
RUN mtstat
RUN mtstop ALL
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX60N SONARDRV SCHEDULER PROGRESS PASS
