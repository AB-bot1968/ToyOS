# FIX60F deterministic UART bounded-service regression (no physical COM required).
PRINT FIX60F UART IRQ CONTRACT TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
EXPECT UART_TRANSPORT
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
PRINT FIX60F UART IRQ CONTRACT TEST COMPLETE
