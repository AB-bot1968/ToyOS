# FIX48 SAFE admission policy regression.
PRINT FIX48 SAFE MODE POLICY TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
RUN safepolicy reset
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_POLICY_FLAGS 0
ASSERT SAFE_DENY_TOTAL 0
RUN safemode degraded 4801
ASSERT SAFE_MODE 1
ASSERT SAFE_POLICY_FLAGS 0
RUN safemode safe 4802
ASSERT SAFE_MODE 2
ASSERT SAFE_POLICY_FLAGS 7
RUN spawn EXIT0.EXE
ASSERT SAFE_DENY_SPAWN 1
ASSERT MT_ACTIVE 0
RUN execmt MT01.EXE
ASSERT SAFE_DENY_MT 1
ASSERT MT_ACTIVE 0
EXPECT SAFE_DENY_RT
ASSERT SAFE_DENY_RT 1
ASSERT RT_ACTIVE 0
ASSERT SAFE_DENY_TOTAL 3
RUN safepolicy
RUN safemode normal 0
ASSERT SAFE_POLICY_FLAGS 0
START RT 1
ASSERT RT_ACTIVE 1
RUN rtstat stop
RUN rtstat reset
RUN mtstop ALL
RUN safepolicy reset
ASSERT SAFE_DENY_TOTAL 0
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
PRINT SAFE MODE POLICY TEST COMPLETE
