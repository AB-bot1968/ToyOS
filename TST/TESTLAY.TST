# FIX53 dynamic disk-layout runtime acceptance.
PRINT FIX53 DYNAMIC LAYOUT TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
ASSERT LAYOUT_VALID
ASSERT LAYOUT_KERNEL_LBA 2
ASSERT LAYOUT_FAT_ALIGNED_SELF
ASSERT LAYOUT_RESERVE_GAP_SEPARATE
ASSERT LAYOUT_MEMORY_VALID
ASSERT LAYOUT_IMAGE_MATCH
ASSERT FS_RW
ASSERT SAFE_MODE 0
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX53 DYNAMIC LAYOUT TEST COMPLETE
