# FIX60 bounded cyclic telemetry logging acceptance.
PRINT FIX60 TELEMETRY LOG TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
EXPECT TELEMETRY_LOG
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX60 TELEMETRY LOG TEST COMPLETE
