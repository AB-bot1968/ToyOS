# FIX60A executable root fallback and shipped SONAR binary acceptance.
PRINT FIX60A EXECUTABLE LOADER TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
RUN cd /DOC
RUN execmt HBEATOK.EXE
ASSERT MT_ACTIVE 1
RUN mtstop ALL
ASSERT MT_ACTIVE 0
RUN cd /
ASSERT FILE_EXISTS /SONARDRV.EXE
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX60A EXECUTABLE LOADER TEST COMPLETE
