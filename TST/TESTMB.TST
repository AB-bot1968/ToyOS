# FIX57 Ring3 Modbus RTU master engine acceptance.
PRINT FIX57 MODBUS RTU TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
EXPECT MODBUS_RTU
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX57 MODBUS RTU TEST COMPLETE
