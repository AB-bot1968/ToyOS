# FIX43 boot/reset diagnostics persistent-marker regression.
PRINT FIX43 BOOT RESET DIAGNOSTICS TEST
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN bootdiag clear
ASSERT BOOT_MARKER_MISSING
RUN bootdiag mark 2
ASSERT BOOT_REASON 2
RUN bootdiag
RUN bootdiag mark 4
ASSERT BOOT_REASON 4
RUN bootdiag clear
ASSERT BOOT_MARKER_MISSING
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
PRINT BOOT RESET DIAGNOSTICS TEST COMPLETE
