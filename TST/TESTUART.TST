# FIX60P deterministic UART transport acceptance; physical polling is tested separately.
PRINT FIX55 UART TRANSPORT TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
EXPECT UART_TRANSPORT
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX55 UART TRANSPORT TEST COMPLETE
