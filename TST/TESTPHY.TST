# FIX60H deterministic transport-policy acceptance. FAT 8.3 name.
PRINT FIX60H PHYSICAL TRANSPORT POLICY TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
EXPECT UART_FULL_POLL
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX60H PHYSICAL TRANSPORT POLICY TEST COMPLETE
