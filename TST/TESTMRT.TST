# FIX60ZEI: FIX60ZEF scheduler preserved; idle-aware heartbeat test contract.
PRINT FIX60ZEI MIXED MT 4RT IDLE-SHELL CONTRACT TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
START MT 2
ASSERT MT_ACTIVE 2
START RT10 4
ASSERT RT_ACTIVE 4
ASSERT RT_SWEEP_FAIR 4 4
# FIX60ZEI: MT slack is granted when the interactive shell is idle, not while
# the foreground TEST command deliberately owns the CPU. Reproduce that exact
# contract before requiring detached MT progress.
ASSERT CONSOLE_IDLE_TICKS 12
ASSERT MT_PROGRESS 1 3
ASSERT MT_PROGRESS 2 3
ASSERT RT_SLOT_PROGRESS 1
ASSERT RT_SLOT_PROGRESS 2
ASSERT RT_SLOT_PROGRESS 3
ASSERT RT_SLOT_PROGRESS 4
RUN rtstat
ASSERT CONSOLE_IDLE_TICKS 8
RUN mtstat
ASSERT RT_SWEEP_FAIR 4 4
ASSERT MT_ACTIVE 2
ASSERT RT_ACTIVE 4
RUN rtstat stop
RUN mtstop ALL
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
# Reproduce the actual persistent-service class deterministically: producer+logger + 4x10ms RT.
PRINT FIX60ZEI SONARLOG + 4RT CONSOLE-IDLE PROGRESS
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
START RT10 4
ASSERT RT_ACTIVE 4
# Give the real idle-shell scheduler windows in which SONARPUB/SONARLOG are
# designed to run, then keep the original heartbeat thresholds unchanged.
ASSERT CONSOLE_IDLE_TICKS 64
ASSERT MT_HEARTBEAT_IDLE_WAIT 2 12 800
ASSERT RT_SWEEP_FAIR 4 4
ASSERT CONSOLE_IDLE_TICKS 64
ASSERT MT_HEARTBEAT_IDLE_WAIT 2 24 1200
ASSERT SONAR_LOG_MIN 8
RUN rtstat
ASSERT CONSOLE_IDLE_TICKS 8
RUN ps
ASSERT MT_ACTIVE 2
ASSERT RT_ACTIVE 4
RUN rtstat stop
RUN mtstop ALL
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
PRINT FIX60ZEI MIXED MT 4RT IDLE-SHELL CONTRACT PASS
