# FIX44 safe/degraded mode foundation regression.
PRINT FIX44 SAFE DEGRADED MODE TEST
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN safemode normal 0
ASSERT SAFE_MODE 0
ASSERT SAFE_REASON 0
RUN safemode degraded 41
ASSERT SAFE_MODE 1
ASSERT SAFE_REASON 41
RUN safemode
RUN safemode safe 77
ASSERT SAFE_MODE 2
ASSERT SAFE_REASON 77
RUN safemode
RUN safemode normal 0
ASSERT SAFE_MODE 0
ASSERT SAFE_REASON 0
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
PRINT SAFE DEGRADED MODE TEST COMPLETE
