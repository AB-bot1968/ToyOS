# FIX50 Recovery Manager exhaustive automated acceptance.
PRINT FIX50 RECOVERY MANAGER TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
RUN eventlog clear
ASSERT SAFE_MODE 0
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN supstart FAULTUD.EXE
WAIT LAST
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 3
ASSERT RM_LIMIT 3
ASSERT RM_ATTEMPTS 3
ASSERT RM_KIND 1
ASSERT RM_ACTION 2
ASSERT SAFE_MODE 2
ASSERT SAFE_REASON 4591
ASSERT EVENT_TYPE 101
ASSERT EVENT_TYPE 103
ASSERT EVENT_TYPE 105
ASSERT EVENT_TYPE 102
ASSERT RECOVERY_FAULT_CHAIN
ASSERT EVENT_SEQ_MONOTONIC
ASSERT EVENT_TICK_MONOTONIC
RUN eventlog save
ASSERT EVENT_DISK_RECOVERY_CHAIN
ASSERT EVENT_DISK_REASON 4591
RUN mtstop ALL
RUN hwwd disarm
RUN safemode normal 0
RUN rtstat stop
RUN rtstat reset
ASSERT SAFE_MODE 0
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX50 RECOVERY MANAGER TEST COMPLETE
