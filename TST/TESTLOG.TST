# FIX42 persistent event/fault log regression.
PRINT FIX42 PERSISTENT EVENT LOG TEST
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN eventlog clear
TYPE spawn FAULTUD.EXE
KEY ENTER
WAIT LAST
ASSERT LAST_REASON 2
ASSERT EVENT_REASON 2
RUN eventlog save
RUN eventlog clear
ASSERT EVENT_DISK_COUNT 1
ASSERT EVENT_DISK_REASON 2
RUN eventlog disk
RUN eventlog clear disk
ASSERT EVENT_DISK_MISSING
RUN mtstop ALL
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
PRINT PERSISTENT EVENT LOG TEST COMPLETE
