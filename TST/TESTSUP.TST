# FIX39 supervisor automatic restart regression
PRINT FIX39 SUPERVISOR REGRESSION
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN safemode normal 0
RUN eventlog clear
ASSERT SAFE_MODE 0
RUN supstart FAULTUD.EXE
WAIT LAST
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 3
ASSERT SAFE_MODE 2
ASSERT SAFE_REASON 4591
ASSERT EVENT_TYPE 101
ASSERT EVENT_TYPE 103
ASSERT EVENT_TYPE 105
ASSERT EVENT_TYPE 102
ASSERT RECOVERY_FAULT_CHAIN
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN mtstop ALL
RUN safemode normal 0
ASSERT SAFE_MODE 0
PRINT SUPERVISOR TEST COMPLETE
