# FIX40 watchdog timeout/restart regression
PRINT FIX40 WATCHDOG TIMEOUT REGRESSION
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN safemode normal 0
RUN eventlog clear
ASSERT SAFE_MODE 0
RUN supstart HANGWD.EXE
WAIT LAST
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 3
ASSERT SAFE_MODE 2
ASSERT SAFE_REASON 4592
ASSERT EVENT_TYPE 104
ASSERT EVENT_TYPE 103
ASSERT EVENT_TYPE 105
ASSERT EVENT_TYPE 102
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN mtstop ALL
RUN safemode normal 0
ASSERT SAFE_MODE 0
PRINT WATCHDOG TIMEOUT TEST COMPLETE
