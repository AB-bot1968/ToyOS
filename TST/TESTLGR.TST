# FIX60S: deterministic real SONARLOG process lifecycle and cyclic-file test.
# SONARPUB.EXE is a paced Data Channel producer only: no UART/Modbus/FAT.
PRINT FIX60S SONARLOG PROCESS/CYCLIC LOG TEST
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
RUN hwwd disarm
RUN safemode normal 0
RUN rm /SONAR.LOG
RUN write /SONAR.LOG BAD
ASSERT FILE_SIZE /SONAR.LOG 3
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT DATA_PUBLISHED_WAIT 0 140 1500
ASSERT MT_HEARTBEAT_WAIT 1 140 1500
ASSERT MT_HEARTBEAT_WAIT 2 130 3000
ASSERT MT_PROGRESS 1 3
ASSERT MT_PROGRESS 2 3
RUN mtstop ALL
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT FILE_SIZE /SONAR.LOG 4160
ASSERT SONAR_LOG_VALID 128
# FIX60ZEE: viewer-alone transient MT session must terminate completely.
RUN spawn SONARVWR.EXE
WAIT LAST
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 0
ASSERT MT_ACTIVE 0
ASSERT FILE_SIZE /SONAR.LOG 4160
ASSERT SONAR_LOG_VALID 128
# Next EXECMT must start immediately; a stale mt_session_active would fail here.
# Nine restart cycles: DATA_READER_MAX is 8, so a leaked reader must fail here.
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
RUN execmt SONARPUB.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
ASSERT PROC_HANDLES 0
# Consumer-first: logger must wait/recover when producer starts after it.
RUN execmt SONARLOG.EXE SONARPUB.EXE
ASSERT MT_ACTIVE 2
ASSERT DATA_PUBLISHED_WAIT 0 5 300
ASSERT MT_HEARTBEAT_WAIT 1 5 300
ASSERT MT_HEARTBEAT_WAIT 2 5 300
RUN mtstop ALL
ASSERT FILE_SIZE /SONAR.LOG 4160
# Final integration with the existing unchanged SONAR test producer.
RUN execmt SONARTST.EXE SONARLOG.EXE
ASSERT MT_ACTIVE 2
ASSERT DATA_PUBLISHED_WAIT 0 20 300
ASSERT MT_HEARTBEAT_WAIT 2 3 300
RUN mtstop ALL
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
ASSERT SAFE_MODE 0
ASSERT HWWD_ARMED 0
ASSERT HEALTH_STATE 0
PRINT FIX60S SONARLOG PROCESS/CYCLIC LOG PASS
