# FIX46 hardware-watchdog control-plane regression.
PRINT FIX46 HARDWARE WATCHDOG FOUNDATION TEST
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN hwwd disarm
ASSERT HWWD_BACKEND 1
ASSERT HWWD_ARMED 0
RUN hwwd arm 100
ASSERT HWWD_ARMED 1
ASSERT HWWD_TIMEOUT 100
ASSERT HWWD_FEEDS 0
RUN hwwd feed
ASSERT HWWD_FEEDS 1
RUN hwwd feed
ASSERT HWWD_FEEDS 2
RUN hwwd status
RUN hwwd disarm
ASSERT HWWD_ARMED 0
ASSERT HWWD_TIMEOUT 0
RUN mtstop ALL
RUN rtstat stop
RUN rtstat reset
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
PRINT HARDWARE WATCHDOG FOUNDATION TEST COMPLETE
