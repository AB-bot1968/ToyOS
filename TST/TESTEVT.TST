# FIX41 structured kernel lifecycle event regression.
PRINT FIX41 EVENT LOG TEST
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN eventlog clear
TYPE spawn FAULTUD.EXE
KEY ENTER
WAIT LAST
ASSERT LAST_REASON 2
ASSERT EVENT_REASON 2
RUN mtstop ALL
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
PRINT EVENT LOG TEST COMPLETE
