# FIX45 supervisor operational-state policy regression
PRINT FIX45 SUPERVISOR POLICY TEST
ASSERT RT_ACTIVE 0
ASSERT MT_ACTIVE 0
ASSERT PROC_HANDLES 0
RUN safemode normal 0
RUN eventlog clear
ASSERT SAFE_MODE 0
RUN supstart HBEATOK.EXE
WAIT LAST
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 0
ASSERT SAFE_MODE 0
RUN mtstop ALL
RUN supstart FAULTUD.EXE
WAIT LAST
ASSERT LAST_REASON 1
ASSERT LAST_STATUS 3
ASSERT SAFE_MODE 2
ASSERT SAFE_REASON 4591
ASSERT RECOVERY_FAULT_CHAIN
RUN mtstop ALL
RUN safemode normal 0
ASSERT SAFE_MODE 0
ASSERT SAFE_REASON 0
RUN rtstat stop
RUN rtstat reset
ASSERT MT_ACTIVE 0
ASSERT RT_ACTIVE 0
ASSERT PROC_HANDLES 0
PRINT SUPERVISOR POLICY TEST COMPLETE
